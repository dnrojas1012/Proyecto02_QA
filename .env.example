# Copie este archivo como .env y ajuste los valores.
# Puerto donde corre la app
PORT=3000
# Cadena de conexión a PostgreSQL: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/gimnasio_seguro
# true solo cuando la base está en la nube (Neon) y exige SSL
DB_SSL=false
# Secreto para firmar la cookie de sesión: una cadena larga y aleatoria
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Minutos/segundos: la sesión se cierra tras 60 s sin actividad (UTN-07c)
SESSION_TIMEOUT_SECONDS=60
# development en su PC, production en Render (activa cookie Secure y HSTS)
NODE_ENV=development
